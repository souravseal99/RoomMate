# ==============================================================================
# RoomMate Server Environment Configuration (.env.example)
# Copy this file to .env and replace dummy placeholders with secure credentials.
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Application Port
APP_PORT=5000

# PostgreSQL Connection String (Prisma ORM)
DATABASE_URL="postgresql://postgres:password@localhost:5432/roommate?schema=public"

# Password Hashing Salt Rounds
BCRYPT_SALT_ROUNDS=10

# JSON Web Token (Access Token) Configuration
# MUST be set to a cryptographically secure random string in production
JWT_SECRET="dev_jwt_secret_key_change_in_production"
JWT_EXPIRES_IN="15m"

# JSON Web Token (Refresh Token) Configuration
# MUST be set to a cryptographically secure random string in production
JWT_REFRESH_SECRET="dev_refresh_secret_key_change_in_production"
JWT_REFRESH_EXPIRES_IN="7d"

# CSRF HMAC Secret Key (Minimum 32 characters)
CSRF_SECRET="roommate_csrf_super_secret_key_2026_at_least_32_characters"

# Secure Cookie Flag (Set to true in HTTPS environments, auto-enabled in NODE_ENV=production)
USE_SECURE_COOKIE="false"

# Container Boot Auto-Seed (Set to 'true' only if you want idempotent seed to run on container launch)
SEED_ON_BOOT="false"

# Local Development Seeding Route (POST /dev/seed)
# Only mounted when NODE_ENV=development and ENABLE_DEV_SEED=true
ENABLE_DEV_SEED="false"
DEV_SEED_SECRET="dev-seed-local-only-token"