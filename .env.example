# ==============================================================================
# RoomMate Docker Compose Environment Configuration (.env.example)
# Copy this file to .env at the root of the repository for docker compose overrides.
# ==============================================================================

# PostgreSQL Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=roommate

# Database Connection (used by server container)
DATABASE_URL=postgresql://postgres:password@db:5432/roommate?schema=public

# Server Secrets (replace with secure random values in production)
JWT_SECRET=dev_secret_key_roommate_2026
JWT_REFRESH_SECRET=dev_refresh_secret_key_roommate_2026
CSRF_SECRET=roommate_csrf_super_secret_key_2026_at_least_32_characters

# Client Configuration
VITE_SERVER_BASE_URL=http://localhost:5000
